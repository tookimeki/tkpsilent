        if clickStart and clickPos then
            local delta = (input.Position - clickPos).Magnitude
            if delta < 5 and (os.clock() - clickStart) < 0.5 then task.spawn(MaximizeGUI) end
            clickStart, clickPos = nil, nil
        end
    end
end)
