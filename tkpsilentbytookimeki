local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

print("Memulai Inisialisasi Silent Farm v2...")

-- Fungsi untuk mencari Remote Function Knit (Biasanya di dalam folder Packages atau Knit)
local function GetKnitRemote(remoteName)
    local foundRemote = nil
    pcall(function()
        for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
            if obj:IsA("RemoteFunction") and obj.Name == remoteName then
                foundRemote = obj
                break
            end
        end
    end)
    return foundRemote
end

local beginCatchRF = GetKnitRemote("BeginCatch")
local redeemCatchRF = GetKnitRemote("RedeemCatch")

if beginCatchRF and redeemCatchRF then
    print("Berhasil mendeteksi jalur Knit Comm Server!")
else
    warn("Jalur Knit Comm belum sepenuhnya dimuat, mencoba mencari ulang...")
end

-- Loop Otomatis di Latar Belakang (Silent Headless Farm)
task.spawn(function()
    while true do
        task.wait(4) -- Jeda antar siklus tangkap agar aman dari deteksi spam server
        
        pcall(function()
            -- Pastikan remote sudah terdeteksi
            if not beginCatchRF or not redeemCatchRF then
                beginCatchRF = GetKnitRemote("BeginCatch")
                redeemCatchRF = GetKnitRemote("RedeemCatch")
                return
            end
            
            -- 1. Panggil BeginCatch untuk meminta Token & Data Hewan ke Server
            -- Sesuai struktur Cobalt: InvokeServer tanpa argumen menghasilkan tabel {ok, token, animalName}
            local success, catchData = pcall(function()
                return beginCatchRF:InvokeServer()
            end)
            
            if success and catchData and catchData.token then
                print("Berhasil memicu tangkapan untuk: " .. tostring(catchData.animalName))
                
                -- Beri jeda sangat singkat (simulasi proses tangkap gaib)
                task.wait(0.2)
                
                -- 2. Panggil RedeemCatch dengan memasukkan token yang diberikan server dan status true
                local redeemSuccess, redeemResult = pcall(function()
                    return redeemCatchRF:InvokeServer(catchData.token, true)
                end)
                
                if redeemSuccess and redeemResult and redeemResult.ok then
                    print("SUKSES! Item masuk inventori: " .. tostring(redeemResult.message))
                end
            end
        end)
    end
end)
