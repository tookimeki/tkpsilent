-- 3. MESIN SILENT FARM v10 (FIXED COOLDOWN & SYNC)
-- ==========================================
local silentFarmActive = false

local function GetKnitRemote(remoteName)
    local foundRemote = nil
    pcall(function()
        for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
            if obj:IsA("RemoteFunction") and obj.Name == remoteName then
                foundRemote = obj
                break
            end
        end
    end)
    return foundRemote
end

task.spawn(function()
    while true do
        -- Jeda diperpanjang menjadi 6 detik agar terhindar dari pesan "Terlalu cepat"
        task.wait(6.0) 
        
        if silentFarmActive then
            pcall(function()
                local character = LocalPlayer.Character
                if character then
                    local humanoid = character:FindFirstChildOfClass("Humanoid")
                    local jaring = LocalPlayer.Backpack:FindFirstChild("Jaring") or character:FindFirstChild("Jaring")
                    if jaring and jaring.Parent ~= character then
                        if humanoid then humanoid:EquipTool(jaring) end
                    end
                end
                
                local beginCatchRF = GetKnitRemote("BeginCatch")
                local redeemCatchRF = GetKnitRemote("RedeemCatch")
                
                if beginCatchRF and redeemCatchRF then
                    local success, catchData = pcall(function()
                        return beginCatchRF:InvokeServer()
                    end)
                    
                    if success and type(catchData) == "table" and catchData.token then
                        Log("Token v10 OK: " .. tostring(catchData.animalName))
                        
                        -- Jeda natural meniru durasi minigame
                        task.wait(1.5)
                        
                        local redeemSuccess, redeemResult = pcall(function()
                            return redeemCatchRF:InvokeServer(catchData.token, true)
                        end)
                        
                        if redeemSuccess and type(redeemResult) == "table" then
                            if redeemResult.ok then
                                Log("SUCCESS: Berhasil menangkap " .. tostring(catchData.animalName))
                            else
                                Log("Ditolak Server: " .. tostring(redeemResult.message))
                            end
                        end
                    else
                        Log("Mencari target hewan (Cooldown)...")
                    end
                else
                    Log("Mencari jalur Knit Comm...")
                end
            end)
        end
    end
end)

