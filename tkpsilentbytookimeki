-- ==========================================
-- 4. MESIN SILENT HEADLESS FARM (KNIT COMM)
-- ==========================================
local silentFarmActive = false

-- Fungsi pencari jalur Knit Remote secara dinamis
local function GetKnitRemote(remoteName)
    local foundRemote = nil
    pcall(function()
        for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
            if obj:IsA("RemoteFunction") and obj.Name == remoteName then
                foundRemote = obj
                break
            end
        end
    end)
    return foundRemote
end

-- Loop Utama di Latar Belakang (Hanya berjalan jika Toggle ON)
task.spawn(function()
    while true do
        task.wait(3.5) -- Jeda aman antar siklus tangkap
        
        if silentFarmActive then
            pcall(function()
                local beginCatchRF = GetKnitRemote("BeginCatch")
                local redeemCatchRF = GetKnitRemote("RedeemCatch")
                
                if beginCatchRF and redeemCatchRF then
                    -- 1. Minta Token Tangkap ke Server secara gaib
                    local success, catchData = pcall(function()
                        return beginCatchRF:InvokeServer()
                    end)
                    
                    if success and catchData and catchData.token then
                        -- Beri jeda singkat menyerupai durasi tangkap alami
                        task.wait(0.3)
                        
                        -- 2. Kirim kembali token konfirmasi ke Server
                        local redeemSuccess, redeemResult = pcall(function()
                            return redeemCatchRF:InvokeServer(catchData.token, true)
                        end)
                        
                        if redeemSuccess and redeemResult and redeemResult.ok then
                            print("[Silent Farm]: Berhasil mendapatkan " .. tostring(redeemResult.message))
                        end
                    end
                end
            end)
        end
    end
end)

