local function MakeDraggable(guiObject)
    local dragging, dragInput, dragStart, startPos
    guiObject.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = guiObject.Position 
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    guiObject.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            local targetX = startPos.X.Offset + delta.X
            local targetY = startPos.Y.Offset + delta.Y
            local viewport = workspace.CurrentCamera.ViewportSize
            local apX, apY = guiObject.AnchorPoint.X, guiObject.AnchorPoint.Y
            local sizeX, sizeY = guiObject.AbsoluteSize.X, guiObject.AbsoluteSize.Y
            local minX, maxX = sizeX * apX, viewport.X - sizeX * (1 - apX)
            local minY, maxY = sizeY * apY, viewport.Y - sizeY * (1 - apY)
            if viewport.X > 0 and viewport.Y > 0 then
                targetX = math.clamp(targetX, minX, maxX)
                targetY = math.clamp(targetY, minY, maxY)
            end
            guiObject.Position = UDim2.new(0, targetX, 0, targetY)
        end
    end)
end
MakeDraggable(MainFrame)
MakeDraggable(OpenBtn)

local tweenInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
local isAnimating = false

local function MaximizeGUI()
    if isAnimating then return end
    isAnimating = true
    local targetX = OpenBtn.Position.X.Offset + 45
    local targetY = OpenBtn.Position.Y.Offset + 50
    local viewport = workspace.CurrentCamera.ViewportSize
    if viewport.X > 0 and viewport.Y > 0 then
        targetX = math.clamp(targetX, 320, viewport.X)
        targetY = math.clamp(targetY, 100, viewport.Y - 100)
    end
    TweenService:Create(OpenBtn, tweenInfo, {Size = UDim2.new(0, 0, 0, 0)}):Play()
    task.wait(0.3)
    OpenBtn.Visible = false
    MainFrame.Size = UDim2.new(0, 0, 0, 0)
    MainFrame.Position = UDim2.new(0, targetX, 0, targetY)
    MainFrame.Visible = true
    TweenService:Create(MainFrame, tweenInfo, {Size = UDim2.new(0, 320, 0, 205)}):Play()
    task.wait(0.3)
    isAnimating = false
end

local function MinimizeGUI()
    if isAnimating then return end
    isAnimating = true
    local mousePos = UserInputService:GetMouseLocation()
    local viewport = workspace.CurrentCamera.ViewportSize
    local safeX = math.clamp(mousePos.X, 17.5, viewport.X - 17.5) 
    local safeY = math.clamp(mousePos.Y, 17.5, viewport.Y - 17.5)
    local targetPos = UDim2.new(0, safeX, 0, safeY)
    TweenService:Create(MainFrame, tweenInfo, {Size = UDim2.new(0, 0, 0, 0), Position = targetPos}):Play()
    task.wait(0.3)
    MainFrame.Visible = false
    OpenBtn.Position = targetPos
    OpenBtn.Size = UDim2.new(0, 0, 0, 0)
    OpenBtn.Visible = true
    TweenService:Create(OpenBtn, tweenInfo, {Size = UDim2.new(0, 35, 0, 35)}):Play()
    task.wait(0.3)
    isAnimating = false
end

